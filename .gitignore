# ==============================================================================
# Git Ignore Rules for "ที่นี่มีอะไร?" (Django Web Application)
# ==============================================================================

# Environment & Secrets (CRITICAL SECURITY)
.env
.env.local
.env.*
*.env
secrets/

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Django Local Database & Logs
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Django Collected Static & User Uploaded Media
staticfiles/
media/
!media/.gitkeep

# Unit Test & Coverage Data
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.noserc
nosetests.xml

# IDEs and Text Editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Agent / Tooling Caches
.gemini/
.agents/
.vercel/

